APP_NAME=追梦短视频智能生产平台
# 生产环境上线前：APP_ENV=production，APP_DEBUG=false（调试信息绝不暴露给用户/公网）
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
# 生产环境必须改为真实域名（含 https），否则 CSRF/回调/资源 URL 全部错乱
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hgt_commercial
DB_USERNAME=hgt
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 出片微服务地址（混合云：本地 Windows 经 frp 穿透到云服务器 127.0.0.1:8500）
PYTHON_PIPELINE_URL=http://host.docker.internal:8500

# 免费试用机制（注册即自动开通，无需审批）
# TRIAL_DAYS：试用天数
# TRIAL_VIDEO_QUOTA：试用期内月度生成次数上限（约 5 元规模）
# TRIAL_MAX_DURATION_SEC：试用期内单条视频时长硬上限（秒），默认 600 = 10 分钟
# 试用版不含批量外发（PublishController 硬闸拦截）；已订阅套餐不受上述时长限制（走 MAX_VIDEO_DURATION_SEC）
TRIAL_DAYS=7
TRIAL_VIDEO_QUOTA=10
TRIAL_MAX_DURATION_SEC=600

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# 宿主项目根（. 挂载到容器 /var/www），供容器<->宿主路径转换
HOST_PROJECT_ROOT=D:/heygem_data/hgt-commercial

# ============================================================================
# 🚀 生产环境上线前必改清单（逐项确认）
# ============================================================================
# 1. APP_ENV=production / APP_DEBUG=false          ← 关闭调试（已完成默认）
# 2. APP_URL=https://你的备案域名                  ← 必须与 ICP 备案域名一致
# 3. APP_KEY=php artisan key:generate --show 生成   ← 每台服务器唯一，勿复用开发 key
# 4. DB_PASSWORD / DB_ROOT_PASSWORD                 ← 强随机密码，勿用空或弱密码
# 5. 租户 admin 密码                                 ← 部署后立刻改掉种子默认 admin888（弱口令）
# 6. PYTHON_PIPELINE_URL                            ← 云端见下方说明
# 7. MAIL_MAILER                                    ← 接真实 SMTP（可选，用于出片完成通知）
# 8. SESSION_SECURE_COOKIE=true（HTTPS 下）         ← 防 cookie 泄露
# ----------------------------------------------------------------------------
# 出片微服务（8500）在混合云架构下的地址：
#   本地开发：http://host.docker.internal:8500
#   云端部署：本机渲染经 frp 穿透到云服务器 127.0.0.1:8500（PYTHON_PIPELINE_URL=http://127.0.0.1:8500）
#   注意：8500 永不暴露公网，只经 frp 内网穿透给 Web 层调用，避免渲染密钥外流
# ============================================================================
