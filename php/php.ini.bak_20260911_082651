; 商用平台 PHP-FPM 运行时配置（挂载到容器 /usr/local/etc/php/conf.d/zz-platform.ini）
; 核心：放开大文件上传（真人素材精剪 ≤500MB，nginx client_max_body_size 256m 已配）

upload_max_filesize = 512M
post_max_size = 512M
max_file_uploads = 20
memory_limit = 512M
; 对话出稿"全写"N 篇口播稿实测 200~280s（每篇一次 LLM 长调用）。
; 同步阶段需跑满长任务：CLI(8500) 300s + 前端兜底 330s，故这里放开到 330s，
; 避免 PHP 在 Laravel/前端之前先掐断导致误判 502。真正根治见异步 job 化改造。
max_execution_time = 330
max_input_time = 330
